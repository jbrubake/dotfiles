# Main HD
regexp=^[a-z]\S*
colours=bold
======
# Partition
regexp=([├└─│]+|[\|\`\-]+)(\S+)
colours=default,default,bright_blue
======
# Partition - LVM
regexp=\s+([├└─│]+|[\|\`\-]+)(\S+)
colours=default,default,bright_cyan
======
# Partition - luks
regexp=\s+([├└─│]+|[\|\`\-]+)(luks\S+)
colours=default,default,bright_magenta
======
# Type crypt
regexp=(?<=\s)crypt\b
colours=bright_magenta
======
# Type disk
regexp=(?<=\s)disk\b
colours=bold
======
# Type lvm
regexp=(?<=\s)lvm\b
colours=bold cyan
======
# Type part
regexp=(?<=\s)part\b
colours=bright_blue
======
# Type loop
regexp=(?<=\s)loop\b
colours=bright_red
======
# Size
regexp=\s\d*[.,]?\d(K|M|G|T)i?\s
colours=green
======
# Mount Path
regexp=(?<=\s)(\/[^\/ ]*)+$
colours=yellow
======
# Mount [SWAP]
regexp=\s\[(SWAP)\]
colours=default,bright_magenta
======
# UUID
regexp=(?<=\s)\b([0-9a-fA-F-]{4,}|[\w-]{38})\b
colours=default,dark cyan
